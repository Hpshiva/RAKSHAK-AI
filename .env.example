# FLASK Configuration
FLASK_SECRET_KEY="replace_with_a_secure_random_string"

# Admin Configuration
ADMIN_EMAIL="your_admin_email@gmail.com"
ADMIN_LOGIN_EMAIL="admin@rakshakai.edu"
ADMIN_LOGIN_PASSWORD="replace_with_a_strong_admin_password"
PRINCIPAL_LOGIN_EMAIL="principal@rakshakai.edu"
PRINCIPAL_LOGIN_PASSWORD="replace_with_a_strong_principal_password"

# Email Configuration for OTP
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD_HERE"

# Comma-separated local camera indexes shown in the dashboard switcher
CAMERA_IDS="0,1,2,3"

# Optional override. Defaults to models/yolo26s.pt (recommended for CPU systems).
YOLO_MODEL_PATH="models/yolo26s.pt"
YOLO_CONFIDENCE="0.45"
YOLO_IMAGE_SIZE="480"
VIOLENCE_CHECK_INTERVAL="30"
FACE_CHECK_INTERVAL="3"
THREAT_CHECK_INTERVAL="4"
THREAT_CONFIDENCE="0.15"
THREAT_IMAGE_SIZE="480"
