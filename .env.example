# FLASK Configuration
FLASK_SECRET_KEY="replace_with_a_secure_random_string"

# Admin Configuration
ADMIN_EMAIL="your_admin_email@gmail.com"

# Optional local-dev-only login (test@gmail.com / 123). Leave unset in
# production; only set to "1" for convenience while developing locally.
RAKSHAK_ALLOW_TEST_LOGIN="0"

# Email Configuration for OTP
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD_HERE"

# Optional ESP32 controller
ESP32_BASE_URL="http://10.111.147.101"
ESP32_TIMEOUT_SECONDS="0.5"
ESP32_RETRY_SECONDS="5"

# CPU inference tuning (use yolov8x.pt on a CUDA system if preferred)
PERSON_MODEL_PATH="models/yolov8s.pt"
RAKSHAK_TORCH_THREADS="4"

# Person count that flags a non-violent scene as HIGH ("Elevated") threat,
# e.g. an unusually large gathering. Tune per camera/site.
RAKSHAK_HIGH_THREAT_PERSON_COUNT="6"
